# --- Prototipo privado: dejar SIEMPRE en false hasta que sea el sitio real ---
# En false: robots.txt bloquea todo, meta robots noindex y cabecera X-Robots-Tag.
NEXT_PUBLIC_INDEXABLE=false

# Dominio publico del prototipo (para canonicals y sitemap)
NEXT_PUBLIC_SITE_URL=https://bl-portal-unico.vercel.app

# --- Supabase (opcional) ---
# Sin estas variables el portal funciona igual, leyendo el dataset local.
# Con ellas, el contenido y el buscador se sirven desde PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el seeder (scripts/seed-supabase.mjs). NUNCA subir a git.
SUPABASE_SERVICE_ROLE_KEY=
